# TeamMind AI — 生产环境变量模板（Zeabur / 公网部署）
# 复制到 Zeabur Variables 面板，勿将真实密钥提交到 Git。

# === 必填（TEAMMIND_ENV=production 时缺少任一项会导致启动失败）===
TEAMMIND_ENV=production
SECRET_KEY=请替换为至少32位随机字符串
JWT_SECRET_KEY=请替换为至少32位随机字符串
TEAMMIND_CORS_ORIGINS=https://your-app.zeabur.app
TEAMMIND_SOCKETIO_CORS_ORIGINS=https://your-app.zeabur.app

# === DeepSeek 大模型（正式生产建议配置；未配置时画像会降级为规则评分）===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENABLED=1

# === 计费 / 扫码支付（页面内展示收款码，MVP 人工核销）===
# 上传微信/支付宝收款码图片 URL，或指向 /uploads 下的静态图
BILLING_WECHAT_QR_URL=
BILLING_ALIPAY_QR_URL=
# 本地开发可设 BILLING_DEV_AUTO_PAY=1，使「我已付款」自动开通；生产务必为 0，由后台「核销」或 webhook 开通
BILLING_DEV_AUTO_PAY=0
# 待支付订单有效分钟数（超时自动过期）
BILLING_ORDER_TTL_MINUTES=30
# 支付回调验签密钥（生产必填；请求头 X-TeamMind-Sign 或 body.sign）
BILLING_WEBHOOK_SECRET=

# === 本地开发（复制为项目根目录 .env，main.py 会自动加载）===
# TEAMMIND_ENV=development
# TEAMMIND_DISABLE_EMAIL_AUTH=1
# TEAMMIND_ALLOW_LEGACY_REGISTER=1
# TEAMMIND_PUBLIC_URL=http://127.0.0.1:5000

# === 认证 / 邮件（正式上线）===
TEAMMIND_DISABLE_DEMO_SEED=1
TEAMMIND_ALLOW_LEGACY_REGISTER=0
TEAMMIND_PUBLIC_URL=https://your-app.zeabur.app
TEAMMIND_EMAIL_DEV_MODE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=1
# 首次创建管理员（仅 bootstrap 脚本使用，勿提交真实密码到 Git）
# TEAMMIND_BOOTSTRAP_ADMIN_EMAIL=
# TEAMMIND_BOOTSTRAP_ADMIN_PASSWORD=

# === 可选 ===
# TEAMMIND_SEED_DEMO_ON_FIRST_BOOT=0
# TEAMMIND_STUDENT_UI=embedded
# DEEPSEEK_TIMEOUT=15
